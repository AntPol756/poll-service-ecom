                "{{user_a_id}}"
              ]
            }
          }
        },
        {
          "name": "Update user A",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"User updated -> 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Address changed\", () => pm.expect(body.address).to.eql(\"Tel Aviv\"));"
                ]
              }
            }
