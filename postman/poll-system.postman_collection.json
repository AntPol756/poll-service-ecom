{
  "info": {
    "name": "Poll System",
    "description": "End-to-end test of the Poll System (User Service + Poll Service). Run the whole collection with the Collection Runner, in order, while `docker compose up` is running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Users - CRUD",
      "item": [
        {
          "name": "Create user A",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"User created -> 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"New user is NOT registered yet\", () => pm.expect(body.is_registered).to.eql(false));",
                  "pm.test(\"Has unique id and joining date\", () => { pm.expect(body.id).to.be.a(\"number\"); pm.expect(body.joining_date).to.include(\"2023-05-10\"); });",
                  "pm.collectionVariables.set(\"user_a_id\", body.id);",
                  "pm.collectionVariables.set(\"user_a_email\", body.email);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{user_url}}/users",
              "host": [
                "{{user_url}}"
              ],
              "path": [
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Dana\",\n  \"last_name\": \"Levi\",\n  \"email\": \"{{$randomEmail}}\",\n  \"age\": 28,\n  \"address\": \"Haifa\",\n  \"joining_date\": \"2023-05-10T00:00:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get user A info",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Get user -> 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"All user fields returned\", () => [\"id\",\"first_name\",\"last_name\",\"email\",\"age\",\"address\",\"joining_date\",\"is_registered\"].forEach(f => pm.expect(body).to.have.property(f)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
